# QuickCart Frontend Environment Template
# Backend API Base URL (leave blank or set to your deployed backend URL in production)
VITE_API_URL=http://localhost:8080
# VITE_API_URL=https://your-production-backend-domain.com

# Google Maps API Key for live address lookup
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Razorpay Client Public Key
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here
