# QuickCart Backend Environment Configuration Template
PORT=8080
NODE_ENV=production

# MongoDB Connection URI (Local MongoDB or Atlas cluster)
MONGO_URI=mongodb://localhost:27017/quickcart
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/quickcart?retryWrites=true&w=majority

# JWT signing secret (use a secure random string)
JWT_SECRET=your_jwt_secret_key_here_min_32_characters

# Admin Access Key for Admin Portal and restricted endpoints
ADMIN_SECRET=your_admin_secret_key_here

# Comma-separated allowed frontend origins for CORS
ALLOWED_ORIGINS=https://orderquickcart.netlify.app,http://localhost:3000,http://localhost:5173

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
